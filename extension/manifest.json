{
  "manifest_version": 3,
  "name": "Gemini Web Bridge",
  "version": "0.1.0",
  "description": "Bridge Codex tasks to the logged-in Gemini web app.",
  "permissions": ["downloads", "tabs"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Gemini Web Bridge",
    "default_popup": "popup.html"
  }
}
